<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VangtiChai" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryDark">@color/teal_primary_dark</item>
        <item name="colorAccent">@color/teal_accent</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="KeypadButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">@dimen/keypad_button_margin</item>
        <item name="android:backgroundTint">@color/button_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">@dimen/text_size_keypad_button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NoteTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/note_text</item>
        <item name="android:textSize">@dimen/text_size_note</item>
        <item name="android:paddingTop">@dimen/note_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/note_padding_vertical</item>
    </style>
</resources>
